{
  "name": "pandit-in-minutes-v2",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build && node --test --test-concurrency=1 tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "env:check": "node --env-file-if-exists=.env scripts/validate-env.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:audit": "node --env-file=.env scripts/audit-db.mjs",
    "db:migrate": "node --env-file=.env scripts/apply-migration.mjs",
    "db:legacy-audit": "node --env-file=.env scripts/audit-legacy-schema.mjs",
    "notifications:audit": "node --env-file=.env scripts/audit-notifications.mjs",
    "db:generate": "drizzle-kit generate",
    "e2e:production-flow": "node --env-file=.env scripts/e2e-production-flow.mjs"
  },
  "dependencies": {
    "cross-env": "^10.0.0",
    "lucide-react": "^0.468.0",
    "next": "16.3.0",
    "pg": "^8.16.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "web-push": "^3.6.7",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260702.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/pg": "^8.15.5",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
