# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# environment files (the placeholder example is intentionally committed)
.env*
!.env.example
!.env.staging.example
.credentials/
*.credentials.json
*.secret

# vercel
.vercel

# typescript
next-env.d.ts
*.tsbuildinfo
/dist/
/dist.stale-*/
/build/*
!/build/sites-vite-plugin.ts
/.wrangler/
/.logs/
/outputs/
/work/
/.backups/

/lib/generated/prisma
